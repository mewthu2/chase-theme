{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
{{ 'chase-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'chase-product-tabs.js' | asset_url }}" defer="defer"></script>

<section
  class="chase-tabs-section color-{{ section.settings.color_scheme }} gradient chase-pad-{{ section.id }}"
  style="--columns: {{ section.settings.columns_desktop }};"
>
  <div class="page-width">
    <chase-tabs class="chase-tabs">
      <div class="chase-section-header chase-tabs__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="chase-heading chase-heading--section">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.blocks.size > 1 -%}
          <div class="chase-tabs__list" role="tablist" aria-label="{{ section.settings.heading | escape }}">
            {%- for block in section.blocks -%}
              <button
                type="button"
                role="tab"
                id="ChaseTab-{{ section.id }}-{{ forloop.index }}"
                aria-controls="ChasePanel-{{ section.id }}-{{ forloop.index }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                class="chase-tabs__tab"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.title | escape -}}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- assign tab_collection = block.settings.collection -%}
        <div
          id="ChasePanel-{{ section.id }}-{{ forloop.index }}"
          class="chase-tabs__panel"
          {% if section.blocks.size > 1 %}
            role="tabpanel" aria-labelledby="ChaseTab-{{ section.id }}-{{ forloop.index }}"
          {% endif %}
          {% unless forloop.first %}
            hidden
          {% endunless %}
        >
          <chase-carousel class="chase-carousel">
            <ul class="chase-carousel__track" role="list">
              {%- if tab_collection != blank and tab_collection.products_count > 0 -%}
                {%- for product in tab_collection.products limit: section.settings.products_to_show -%}
                  <li class="chase-carousel__slide">
                    {% render 'card-product',
                      card_product: product,
                      media_aspect_ratio: 'portrait',
                      show_secondary_image: true,
                      show_vendor: false,
                      show_rating: false,
                      lazy_load: true,
                      skip_styles: true,
                      section_id: section.id,
                      quick_add: 'standard'
                    %}
                  </li>
                {%- endfor -%}
              {%- elsif request.design_mode -%}
                {%- for i in (1..4) -%}
                  <li class="chase-carousel__slide">
                    {% render 'card-product', media_aspect_ratio: 'portrait', placeholder_image: 'product-apparel-1' %}
                  </li>
                {%- endfor -%}
              {%- endif -%}
            </ul>
            <div class="chase-carousel__controls">
              <button type="button" class="chase-carousel__button" data-dir="prev" aria-label="{{ 'general.slider.previous_slide' | t }}">
                <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
              </button>
              <button type="button" class="chase-carousel__button" data-dir="next" aria-label="{{ 'general.slider.next_slide' | t }}">
                <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
              </button>
            </div>
          </chase-carousel>
          {%- if block.settings.show_link and tab_collection != blank -%}
            <div class="chase-tabs__footer">
              <a href="{{ tab_collection.url }}" class="chase-link">{{ 'chase.tabs.view_all' | t }}</a>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </chase-tabs>
  </div>
</section>

{% style %}
  .chase-pad-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .chase-pad-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Chase: Produtos em abas",
  "tag": "div",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Mais desejados" },
    { "type": "range", "id": "products_to_show", "label": "Produtos por aba", "min": 4, "max": 16, "step": 1, "default": 12 },
    { "type": "range", "id": "columns_desktop", "label": "Produtos visíveis no desktop", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Espaço acima", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço abaixo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Aba",
      "settings": [
        { "type": "text", "id": "title", "label": "Título da aba", "default": "Feminino" },
        { "type": "collection", "id": "collection", "label": "Coleção" },
        { "type": "checkbox", "id": "show_link", "label": "Mostrar link \"Ver tudo\"", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chase: Produtos em abas",
      "blocks": [
        { "type": "tab", "settings": { "title": "Mais vendidos" } },
        { "type": "tab", "settings": { "title": "Novidades" } }
      ]
    }
  ]
}
{% endschema %}
