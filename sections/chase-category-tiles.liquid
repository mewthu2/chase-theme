{{ 'chase-sections.css' | asset_url | stylesheet_tag }}

<section
  class="chase-tiles color-{{ section.settings.color_scheme }} gradient chase-pad-{{ section.id }}"
  style="--columns: {{ section.settings.columns_desktop }};"
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.link_label != blank -%}
      <div class="chase-section-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="chase-heading chase-heading--section">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="chase-link" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.link_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="chase-tiles__grid chase-scroller" role="list">
      {%- for block in section.blocks -%}
        <li class="chase-tile" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="chase-tile__link">
            <div class="chase-tile__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(min-width: 990px) 25vw, 75vw',
                    loading: 'lazy',
                    alt: block.settings.title
                }}
              {%- else -%}
                {{ 'collection-apparel-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="chase-tile__content">
              {%- if block.settings.title != blank -%}
                <h3 class="chase-heading chase-tile__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="chase-tile__subtitle">{{ block.settings.subtitle | escape }}</p>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% style %}
  .chase-pad-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .chase-pad-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Chase: Categorias",
  "tag": "div",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Compre por categoria" },
    { "type": "text", "id": "link_label", "label": "Texto do link", "default": "Ver tudo" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "range", "id": "columns_desktop", "label": "Colunas no desktop", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Espaço acima", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço abaixo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Categoria",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem" },
        { "type": "text", "id": "title", "label": "Título", "default": "Leggings" },
        { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "A partir de R$329" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chase: Categorias",
      "blocks": [
        { "type": "tile", "settings": { "title": "Leggings" } },
        { "type": "tile", "settings": { "title": "Tops" } },
        { "type": "tile", "settings": { "title": "Shorts" } },
        { "type": "tile", "settings": { "title": "Casual" } }
      ]
    }
  ]
}
{% endschema %}
