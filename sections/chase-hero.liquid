{{ 'chase-sections.css' | asset_url | stylesheet_tag }}

<section
  class="chase-hero chase-hero--{{ section.settings.height }} chase-hero--{{ section.settings.text_position }} color-{{ section.settings.color_scheme }}"
  style="--overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="chase-hero__media">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false,
          image_size: '1920x',
          class: 'chase-hero__video'
      }}
    {%- elsif section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w"
            sizes="100vw"
          >
        {%- endif -%}
        {%- liquid
          if section.index == 1
            assign loading = 'eager'
            assign priority = 'high'
          else
            assign loading = 'lazy'
            assign priority = 'auto'
          endif
        -%}
        {{
          section.settings.image
          | image_url: width: 3000
          | image_tag:
            widths: '750, 1100, 1500, 1920, 2400, 3000',
            sizes: '100vw',
            loading: loading,
            fetchpriority: priority,
            alt: section.settings.image.alt
        }}
      </picture>
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'chase-hero__placeholder' }}
    {%- endif -%}
  </div>

  <div class="chase-hero__content page-width">
    {%- if section.settings.subheading != blank -%}
      <p class="chase-hero__eyebrow">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="chase-heading chase-heading--xl chase-hero__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="chase-hero__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
      <div class="chase-hero__buttons">
        {%- if section.settings.button_label_1 != blank -%}
          <a href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}" class="chase-btn chase-btn--light">
            {{- section.settings.button_label_1 | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 | default: routes.all_products_collection_url }}" class="chase-btn chase-btn--light">
            {{- section.settings.button_label_2 | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Chase: Hero",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagem (mobile)" },
    { "type": "video", "id": "video", "label": "Vídeo", "info": "Substitui a imagem quando preenchido" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Escurecer imagem",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "select",
      "id": "height",
      "label": "Altura",
      "options": [
        { "value": "small", "label": "Pequena" },
        { "value": "medium", "label": "Média" },
        { "value": "full", "label": "Tela cheia" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Posição do texto",
      "options": [
        { "value": "bottom-left", "label": "Inferior esquerda" },
        { "value": "bottom-center", "label": "Inferior centro" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "bottom-left"
    },
    { "type": "text", "id": "subheading", "label": "Texto acima do título", "default": "Novo drop" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Feito para treinar" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "text", "id": "button_label_1", "label": "Botão 1", "default": "Feminino" },
    { "type": "url", "id": "button_link_1", "label": "Link do botão 1" },
    { "type": "text", "id": "button_label_2", "label": "Botão 2", "default": "Masculino" },
    { "type": "url", "id": "button_link_2", "label": "Link do botão 2" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores", "default": "scheme-3" }
  ],
  "presets": [{ "name": "Chase: Hero" }]
}
{% endschema %}
