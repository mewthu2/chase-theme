{%- liquid
  assign look_products = product.metafields.custom.complete_the_look.value
-%}
{%- if look_products != blank -%}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  {{ 'chase-carousel.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'chase-product-tabs.js' | asset_url }}" defer="defer"></script>

  <section
    class="chase-complete-look color-{{ section.settings.color_scheme }} gradient chase-pad-{{ section.id }}"
    style="--columns: {{ section.settings.columns_desktop }};"
  >
    <div class="page-width">
      <div class="chase-section-header">
        <h2 class="chase-heading chase-heading--section">{{ section.settings.heading | escape }}</h2>
      </div>
      <chase-carousel class="chase-carousel">
        <ul class="chase-carousel__track" role="list">
          {%- for look_product in look_products limit: 12 -%}
            <li class="chase-carousel__slide">
              {% render 'card-product',
                card_product: look_product,
                media_aspect_ratio: 'portrait',
                show_secondary_image: true,
                lazy_load: true,
                skip_styles: true,
                section_id: section.id,
                quick_add: 'standard'
              %}
            </li>
          {%- endfor -%}
        </ul>
        <div class="chase-carousel__controls">
          <button type="button" class="chase-carousel__button" data-dir="prev" aria-label="{{ 'general.slider.previous_slide' | t }}">
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
          <button type="button" class="chase-carousel__button" data-dir="next" aria-label="{{ 'general.slider.next_slide' | t }}">
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
        </div>
      </chase-carousel>
    </div>
  </section>

  {% style %}
    .chase-pad-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
      .chase-pad-{{ section.id }} {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Chase: Complete o look",
  "tag": "div",
  "class": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Mostra os produtos do metafield custom.complete_the_look (lista de produtos). Se estiver vazio, a seção não aparece."
    },
    { "type": "text", "id": "heading", "label": "Título", "default": "Complete o look" },
    { "type": "range", "id": "columns_desktop", "label": "Produtos visíveis no desktop", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Espaço acima", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço abaixo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [{ "name": "Chase: Complete o look" }]
}
{% endschema %}
