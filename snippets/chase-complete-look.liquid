{% doc %}
  Renders the "Complete o look" product info block: a compact horizontal list of products from the
  custom.complete_the_look metafield (product list). Renders nothing when the metafield is empty.

  @param {product} product - The current product
  @param {object} block - The main-product block (settings: heading)

  @example
  {% render 'chase-complete-look', product: product, block: block %}
{% enddoc %}
{%- assign look_products = product.metafields.custom.complete_the_look.value -%}
{%- if look_products != blank -%}
  <div class="chase-look quick-add-hidden" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <h2 class="chase-look__heading">{{ block.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="chase-look__list" role="list">
      {%- for look_product in look_products limit: 8 -%}
        <li class="chase-look__item">
          <a href="{{ look_product.url }}" class="chase-look__link">
            <div class="chase-look__media">
              {%- if look_product.featured_media -%}
                {{
                  look_product.featured_media
                  | image_url: width: 400
                  | image_tag: loading: 'lazy', sizes: '160px', widths: '160, 240, 320, 400', alt: look_product.title
                }}
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <span class="chase-look__title">{{ look_product.title | escape }}</span>
            <span class="chase-look__price{% if look_product.compare_at_price > look_product.price %} chase-sale{% endif %}">
              {{- look_product.price | money -}}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}
